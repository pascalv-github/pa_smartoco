#region Prolog
MinorErrorLogMax = -1;
OnMinorErrorDoItemSkip = 1;
CurrentLogSetting = CubeGetLogChanges('aPyG');
CubeSetLogChanges('aPyG', 0);
NumRowsRead = 0;
NumRowsProcessed = 0;
SetInputCharacterSet('TM1CS_ISO_8859_1');
#endregion
#region Data
NumRowsRead = NumRowsRead + 1;
CellPutN(StringToNumberEx(vValue,'.',','),'aPyG',vDim1,vDim2,'Actual',vDim4);
NumRowsProcessed = NumRowsProcessed + 1;
#endregion
#region Epilog
If (pResult @<> '');
TextOutput(pResult, NumberToString(NumRowsRead), NumberToString(NumRowsProcessed));
EndIf;
CubeSaveData('aPyG');
CubeSetLogChanges('aPyG', CurrentLogSetting);
#endregion